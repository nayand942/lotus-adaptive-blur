+@Composable
+fun AppleSeekBar(
+    position: Long,
+    duration: Long,
+    isPlaying: Boolean,
+    onPositionChange: (Long) -> Unit,
+    modifier: Modifier = Modifier
+) {
+    var fraction by remember { mutableFloatStateOf(0f) }
+    var dragging by remember { mutableStateOf(false) }
+    var width by remember { mutableFloatStateOf(0f) }
+    val isLtr = LocalLayoutDirection.current == LayoutDirection.Ltr
+
+    LaunchedEffect(position, duration) {
+        if (!dragging) {
+            fraction = if (duration <= 0L) 0f
+            else (position.toFloat() / duration).coerceIn(0f, 1f)
+        }
+    }
+
+    Row(modifier.fillMaxWidth(), horizontalArrangement = Arrangement.Center) {
+        Box(
+            Modifier
+                .weight(1f)
+                .height(28.dp)
+                .onGloballyPositioned { width = it.size.width.toFloat() }
+                .pointerInput(duration, isLtr) {
+                    detectTapGestures { offset ->
+                        val x = if (isLtr) offset.x else width - offset.x
+                        fraction = if (width <= 0f) 0f else (x / width).coerceIn(0f, 1f)
+                        onPositionChange((fraction * duration).toLong())
+                    }
+                }
+                .pointerInput(duration, isLtr) {
+                    detectDragGestures(
+                        onDragStart = { dragging = true },
+                        onDragEnd = {
+                            dragging = false
+                            onPositionChange((fraction * duration).toLong())
+                        }
+                    ) { change, dragAmount ->
+                        change.consume()
+                        val delta = if (isLtr) dragAmount.x else -dragAmount.x
+                        fraction = (
+                            fraction + if (width <= 0f) 0f else delta / width
+                        ).coerceIn(0f, 1f)
+                    }
+                }
+        ) {
+            Canvas(Modifier.fillMaxWidth().height(28.dp)) {
+                val y = size.height / 2f
+                drawLine(
+                    color = Color.White.copy(alpha = 0.22f),
+                    start = androidx.compose.ui.geometry.Offset(0f, y),
+                    end = androidx.compose.ui.geometry.Offset(size.width, y),
+                    strokeWidth = 2.dp.toPx()
+                )
+                drawLine(
+                    color = MaterialTheme.colorScheme.primary,
+                    start = androidx.compose.ui.geometry.Offset(0f, y),
+                    end = androidx.compose.ui.geometry.Offset(size.width * fraction, y),
+                    strokeWidth = 2.dp.toPx()
+                )
+            }
+        }
+    }
+
+    Row(
+        Modifier
+            .fillMaxWidth()
+            .padding(top = 1.dp),
+        horizontalArrangement = Arrangement.SpaceBetween
+    ) {
+        Text(
+            text = formatAppleTime(if (dragging) (fraction * duration).toLong() else position),
+            style = MaterialTheme.typography.bodySmall,
+            color = Color.White.copy(alpha = 0.58f)
+        )
+        Text(
+            text = formatAppleTime(duration),
+            style = MaterialTheme.typography.bodySmall,
+            color = Color.White.copy(alpha = 0.58f)
+        )
+    }
+}
+
+private fun formatAppleTime(milliseconds: Long): String {
+    val seconds = milliseconds.coerceAtLeast(0L) / 1000L
+    val hours = seconds / 3600L
+    val minutes = (seconds % 3600L) / 60L
+    val secs = seconds % 60L
+    return if (hours > 0L) {
+        "%d:%02d:%02d".format(hours, minutes, secs)
+    } else {
+        "%d:%02d".format(minutes, secs)
+    }
+}
