+@Composable
+private fun AppleVolumeSlider(modifier: Modifier = Modifier) {
+    val context = LocalContext.current
+    val audioManager = remember {
+        context.getSystemService(AudioManager::class.java)
+    }
+    val maxVolume = remember {
+        audioManager.getStreamMaxVolume(AudioManager.STREAM_MUSIC)
+    }
+    var volume by remember {
+        mutableFloatStateOf(
+            audioManager.getStreamVolume(AudioManager.STREAM_MUSIC).toFloat()
+        )
+    }
+
+    fun setVolume(fraction: Float) {
+        val value = (fraction.coerceIn(0f, 1f) * maxVolume).toInt()
+        volume = value.toFloat()
+        audioManager.setStreamVolume(AudioManager.STREAM_MUSIC, value, 0)
+    }
+
+    Row(
+        modifier = modifier.fillMaxWidth(),
+        verticalAlignment = Alignment.CenterVertically
+    ) {
+        Icon(
+            Icons.Rounded.VolumeDown,
+            null,
+            tint = Color.White.copy(alpha = 0.55f),
+            modifier = Modifier.size(20.dp)
+        )
+        Box(
+            Modifier
+                .weight(1f)
+                .height(28.dp)
+                .pointerInput(maxVolume) {
+                    detectTapGestures { offset ->
+                        setVolume(offset.x / size.width)
+                    }
+                }
+                .pointerInput(maxVolume) {
+                    detectDragGestures { change, _ ->
+                        change.consume()
+                        setVolume(change.position.x / size.width)
+                    }
+                }
+        ) {
+            Canvas(Modifier.fillMaxSize()) {
+                val y = size.height / 2f
+                val fraction = if (maxVolume == 0) 0f else volume / maxVolume
+                drawLine(
+                    color = Color.White.copy(alpha = 0.20f),
+                    start = androidx.compose.ui.geometry.Offset(0f, y),
+                    end = androidx.compose.ui.geometry.Offset(size.width, y),
+                    strokeWidth = 2.dp.toPx()
+                )
+                drawLine(
+                    color = MaterialTheme.colorScheme.primary.copy(alpha = 0.82f),
+                    start = androidx.compose.ui.geometry.Offset(0f, y),
+                    end = androidx.compose.ui.geometry.Offset(size.width * fraction, y),
+                    strokeWidth = 2.dp.toPx()
+                )
+            }
+        }
+        Icon(
+            Icons.Rounded.VolumeUp,
+            null,
+            tint = Color.White.copy(alpha = 0.55f),
+            modifier = Modifier.size(20.dp)
+        )
+    }
+}
